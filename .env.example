# Generate a local secret with: recap init-env
# Never commit .env. This template contains no password.
POSTGRES_USER=recap
POSTGRES_DB=recap
POSTGRES_PASSWORD=
# Host Python commands can use DATABASE_URL or POSTGRES_PASSWORD plus these values.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=55432
# RECAP_POSTGRES_PORT=55432
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
